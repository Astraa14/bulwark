{
  "name": "bulwark",
  "version": "1.0.0",
  "description": "External security posture and Safe-to-Ship monitor for AI-built web apps, GitHub repositories, and Supabase projects.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Astraa14/bulwark.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "scan": "node --env-file=.env.local server/run-checks.mjs",
    "api": "node --env-file=.env.local server/api.mjs",
    "worker": "node --env-file=.env.local server/worker.mjs",
    "start": "node server/start.mjs",
    "test": "node --experimental-strip-types --test \"server/**/*.test.mjs\"",
    "db:apply-all": "node scripts/build-apply-all.mjs",
    "db:check": "node scripts/build-apply-all.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "express": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
