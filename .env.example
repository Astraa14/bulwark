# --- Supabase (required) ---
# Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only. Never expose to the browser. Used by the scanner.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Encrypts user BYOK API keys at rest (32+ random chars).
BULWARK_ENCRYPTION_KEY=change-me-to-a-long-random-string

# How often the local scan worker looks for due sites (seconds).
SCAN_POLL_SECONDS=60

# Public URL of the app, used in Slack alert links.
BULWARK_APP_URL=http://localhost:8443
