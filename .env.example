# --- Supabase (required) ---
# Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only. Never expose to the browser. Used by the scanner.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Encrypts user BYOK API keys and Slack webhooks at rest (32+ random chars).
# Back this value up: losing it makes stored credentials unreadable.
BULWARK_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional key rotation. Move the old BULWARK_ENCRYPTION_KEY here, put a new
# random value in BULWARK_ENCRYPTION_KEY, and restart. Old rows still decrypt;
# comma-separate several retired keys if needed.
BULWARK_ENCRYPTION_KEY_OLD=

# Optional. Extra browser origins allowed to call the API (comma separated),
# e.g. a Vercel preview URL. Production BULWARK_APP_URL is always allowed.
BULWARK_ALLOWED_ORIGINS=

# Max scans (site/GitHub/Supabase) running at once in one API process.
BULWARK_SCAN_CONCURRENCY=2

# How often the local scan worker looks for due sites (seconds).
SCAN_POLL_SECONDS=60

# Port for the API. On Render, the PORT env var (set automatically) wins.
API_PORT=8787

# Public URL of the app, used in Slack alert links.
BULWARK_APP_URL=http://localhost:8443

# Optional. Set only when the API is not served from the same origin as the SPA.
VITE_API_URL=
